# Provider selection: mock | gemini | compat
# "mock" needs no keys at all — the deterministic fallback answers the golden paths.
NIVARAN_PROVIDER=mock

# --- Option 1: Google Gemini (free AI Studio key, no card) ---
# NIVARAN_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.0-flash

# --- Option 2: any OpenAI-compatible API (Groq, Sarvam, OpenRouter, OpenAI) ---
# NIVARAN_PROVIDER=compat
# COMPAT_BASE_URL=https://api.groq.com/openai/v1
# COMPAT_API_KEY=your-key-here
# COMPAT_MODEL=llama-3.3-70b-versatile

# --- Demo build (docs/demo-build-plan.md) ---
# Shared demo code. The phone/web app sends it as x-nivaran-demo-key; without it the voice and document routes refuse.
# NIVARAN_DEMO_KEY=some-long-random-string
# Gemini Live model and voice for /api/live-token (both free-tier models work; 3.1 first, 2.5 native audio as fallback).
# LIVE_MODEL=gemini-3.1-flash-live-preview
# LIVE_VOICE=Kore
# LIVE_TOKEN_LOCK_MODEL=1
# Document reading: fixture (default, no network) or live (gemini-2.5-flash reads the two synthetic sample documents).
# NIVARAN_EXTRACT_MODE=fixture
# EXTRACT_MODEL=gemini-2.5-flash
# Typed chat goes through generateContent on this model (free tier).
# CHAT_MODEL=gemini-3.7-flash
# Used when the primary chat model answers 503 or 429.
# CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash
# Second key from a different Google Cloud project: its own free quota, used after a 429 on the primary key.
# GEMINI_API_KEY_BACKUP=
